{
  "name": "fieldtab-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node node_modules/expo/bin/cli start --dev-client",
    "android": "node node_modules/expo/bin/cli run:android",
    "ios": "node node_modules/expo/bin/cli run:ios",
    "test": "node --test tests/*.test.cjs",
    "postinstall": "patch-package",
    "prebuild": "node node_modules/expo/bin/cli prebuild",
    "bundle": "node node_modules/expo/bin/cli export --platform all"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-image-picker": "~17.0.10",
    "expo-print": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-system-ui": "~6.0.9",
    "jszip": "3.10.1",
    "patch-package": "8.0.1",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0"
  },
  "overrides": {
    "postcss": "8.5.33",
    "image-size": "2.1.0",
    "glob@>=9": "14.0.6",
    "minimatch@>=7": "11.0.9",
    "@expo/cli": {
      "expo": "$expo"
    }
  }
}
